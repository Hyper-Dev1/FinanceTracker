{
  "expo": {
    "name": "Simple Finance",
    "slug": "SimpleFinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/simplefinance.png",
    "scheme": "simplefinance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/simplefinance.png",
        "backgroundImage": "./assets/images/simplefinance.png",
        "monochromeImage": "./assets/images/simplefinance.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.android.finance_tracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/simplefinance.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "01d442e7-453b-4cca-8878-82dac4f62b07"
      }
    }
  }
}
